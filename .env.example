# Microsoft Entra External ID — SPA Application
# Register a SPA app in your External ID (CIAM) tenant and grant it the API's access scope.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# API base URL — the deployed dataverse-contact-api root
# (optional — defaults to https://api.dataverse-contact.tnapps.co.uk)
VITE_API_BASE_URL=https://api.dataverse-contact.tnapps.co.uk
